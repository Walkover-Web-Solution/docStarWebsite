{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docstar-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Domains live here so a deploy doesn't remove them.
  "routes": [{ "pattern": "docstar.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The database goes through Hyperdrive (db.ts uses env.HYPERDRIVE.connectionString). The id isn't secret.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "dc5b5fac8c4a4ec1b222ab4390b6992d" }],
  // Not secret: identifiers of the viaSocket project. VIASOCKET_EMBED_SECRET is a Worker secret (dashboard or `wrangler secret put`).
  "vars": {
    "VIASOCKET_ORG_ID": "4255",
    "VIASOCKET_PROJECT_ID": "projgKgoIAH2"
  }
}
