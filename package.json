{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "migrate": "node scripts/migrate.mjs",
    "admin:user": "node scripts/admin-user.mjs",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "framer-motion": "12.23.15",
    "jose": "6.2.13",
    "lucide-react": "0.544.0",
    "next": "15.5.3",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-fast-marquee": "1.6.5",
    "react-intersection-observer": "9.16.0",
    "saas": "1.0.0",
    "sass": "1.99.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "20.19.17",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "wrangler": "4.151.3"
  }
}
