# The website runs its own backend: pages, ideas, A/B tests, analytics and the AI autopilot all live in
# this repo and use one Postgres database. Copy this file to .env.local and fill it in.

# Postgres (create the database "docstar-website", then `npm run migrate` creates the tables)
DATABASE_URL=postgres://user:password@localhost:5432/docstar-website

# Signs the admin sign-in cookie. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# Lets the daily GitHub job start the autopilot (see .github/workflows/autopilot.yml): openssl rand -hex 24
CRON_SECRET=

# AI for the autopilot, through viaSocket (no model key of our own): viaSocket > Integrations > embed > Install Code
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
# Optional: change the model (defaults: anthropic / claude-sonnet-4-6)
# AUTOPILOT_AI_SERVICE=
# AUTOPILOT_AI_MODEL=

# Blog autopilot (Admin > Website > Blog): saves AI drafts to the DocStar "Blogs" collection.
# A DocStar API token (hm_...) of a team member with write access to that collection: app.docstar.io > API tokens
DOCSTAR_API_TOKEN=
# Optional: the webhook URL of a viaSocket flow (Webhook trigger -> Slack "Send message" with the field `text`;
# Slack is connected and the channel chosen in viaSocket), called when a draft is ready or a run fails
# BLOG_NOTIFY_WEBHOOK_URL=

# Optional: the site's public address (default https://docstar.io)
# NEXT_PUBLIC_SITE_URL=https://docstar.io
