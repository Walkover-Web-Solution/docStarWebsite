# hitman-api base URL. Unset = pages render from the copy bundled in src/content.
DOCSTAR_API_URL=https://api.docstar.io
# Shared with hitman-api: verifies admin preview links and fetches drafts while previewing.
SITE_PREVIEW_SECRET=
# Shared with hitman-api: lets hitman-api refresh cached pages after a publish.
SITE_REVALIDATE_SECRET=
# Shared with hitman-api: lets the website server send analytics events.
SITE_EVENTS_SECRET=
